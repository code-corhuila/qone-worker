# Names only; values live in qone-infra/.env (never versioned). Everything the worker reads.
RABBITMQ_URL=amqp://qampus:password@rabbitmq:5672/%2F
# One relay connection per domain outbox (the documented exception of 09-microservices/08-worker)
BILLING_OUTBOX_URL=postgresql://billing:password@billing-db:5432/billing
CATALOG_OUTBOX_URL=postgresql://catalog:password@catalog-db:5432/catalog
ENROLLMENT_OUTBOX_URL=postgresql://enrollment:password@enrollment-db:5432/enrollment
RELAY_EVERY_SECONDS=5
BATCH_SIZE=100
RUN_TIMEOUT_SECONDS=20
LOG_LEVEL=info
