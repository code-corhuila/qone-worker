# Names only; values live in qone-infra/.env (never versioned). Everything the worker reads.
RABBITMQ_URL=amqp://qampus:password@rabbitmq:5672/%2F
# One relay connection per domain outbox (the documented exception of 09-microservices/08-worker)
BILLING_OUTBOX_URL=postgresql://billing:password@billing-db:5432/billing
CATALOG_OUTBOX_URL=postgresql://catalog:password@catalog-db:5432/catalog
ENROLLMENT_OUTBOX_URL=postgresql://enrollment:password@enrollment-db:5432/enrollment
ADVISOR_OUTBOX_URL=postgresql://advisor:password@advisor-db:5432/advisor
# The advisor's maintenance jobs; when empty they use ADVISOR_OUTBOX_URL
ADVISOR_MAINTENANCE_URL=
RELAY_EVERY_SECONDS=5
EXPIRE_PLANS_EVERY_SECONDS=30
PRUNE_LLM_CACHE_EVERY_SECONDS=3600
LLM_CACHE_KEEP_DAYS=7
# The sweep of overdue seat reservations through CA-13 (HU-PLT-003); runs only with SERVICE_TOKEN
CATALOG_API_URL=http://qone-catalog-api:8000
SERVICE_TOKEN=
EXPIRE_RESERVATIONS_EVERY_SECONDS=60
HTTP_TIMEOUT_SECONDS=5
HTTP_ATTEMPTS=3
BATCH_SIZE=100
RUN_TIMEOUT_SECONDS=20
PORT=8000
LOG_LEVEL=info
